# Local development only. Copy to .env (gitignored) if you want the API
# process to pick these up. Do not put production passwords in git.
DATABASE_URL=postgresql://fish:fish@localhost:5432/fish_onestop

# Set to 1 when the API is served over HTTPS so the session cookie is Secure.
# Leave unset for local HTTP. Secure cookies are not stored on http:// pages.
COOKIE_SECURE=

# Optional local directory for uploaded observation photos.
# Keys go in media.storage_key; the bytes stay on disk, not in Postgres.
# MEDIA_ROOT=

# Google sign-in (optional). Create a Web application OAuth client in
# Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
# Leave these blank to hide "Sign in with Google"; username/password still works.
# Never commit the real client secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
